# Environnement d'exécution : development | production
# - development (défaut) : reload uvicorn actif, CORS élargi
# - production : à mettre sur le VPS (pas de reload)
STATUS_ENVIRONMENT=development

# Token requis par /api/setup (première installation).
# Le définir sur un serveur public : le premier visiteur peut créer le
# compte admin, le token empêche un bot de prendre la place.
# Générer un token : python3 -c "import secrets; print(secrets.token_hex(32))"
# STATUS_SETUP_TOKEN=change_me
